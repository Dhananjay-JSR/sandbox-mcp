# Sandbox MCP configuration.
# Copy to .env and edit. Every value has a working default; nothing here is
# required to start. Settings are read with the SANDBOX_MCP_ prefix.

# ---------------------------------------------------------------------------
# Docker connection
# ---------------------------------------------------------------------------
# Leave unset and the server probes the usual sockets, in order:
#   /var/run/docker.sock, ~/.docker/run/docker.sock (Docker Desktop),
#   ~/.orbstack/run/docker.sock, ~/.colima/default/docker.sock, ~/.rd/docker.sock
# The Docker CLI's *context* is not consulted, so set this explicitly if your
# runtime puts the socket somewhere unusual.
# DOCKER_HOST=unix:///var/run/docker.sock
# SANDBOX_MCP_DOCKER_TIMEOUT_SECONDS=60
# SANDBOX_MCP_IMAGE_PULL_TIMEOUT_SECONDS=600

# ---------------------------------------------------------------------------
# State: SQLite database, project snapshots, collected artifacts
# ---------------------------------------------------------------------------
# SANDBOX_MCP_STATE_DIR=~/.sandbox-mcp

# ---------------------------------------------------------------------------
# Defaults applied when an experiment does not specify one
# ---------------------------------------------------------------------------
# SANDBOX_MCP_DEFAULT_BASE_IMAGE=debian:bookworm-slim
# SANDBOX_MCP_DEFAULT_NETWORK_MODE=none          # none | restricted | enabled
# SANDBOX_MCP_DEFAULT_MOUNT_STRATEGY=COPY_TO_SANDBOX
# SANDBOX_MCP_DEFAULT_CPU_LIMIT=2
# SANDBOX_MCP_DEFAULT_MEMORY_LIMIT=2GB
# SANDBOX_MCP_DEFAULT_TIMEOUT_SECONDS=120
# SANDBOX_MCP_DEFAULT_PIDS_LIMIT=512

# ---------------------------------------------------------------------------
# Ceilings. A request may ask for less; asking for more is clamped, and the
# clamp is reported back to the agent as a warning.
# ---------------------------------------------------------------------------
# SANDBOX_MCP_MAX_CPU_LIMIT=4
# SANDBOX_MCP_MAX_MEMORY_LIMIT=8GB
# SANDBOX_MCP_MAX_TIMEOUT_SECONDS=1800
# SANDBOX_MCP_MAX_PIDS_LIMIT=2048
# SANDBOX_MCP_MAX_CONCURRENT_EXPERIMENTS=10
# SANDBOX_MCP_MAX_CONCURRENT_JOBS_PER_EXPERIMENT=4
# SANDBOX_MCP_TMPFS_SIZE_MB=512

# ---------------------------------------------------------------------------
# Payload caps
# ---------------------------------------------------------------------------
# SANDBOX_MCP_MAX_OUTPUT_BYTES=1000000           # per stream, per command
# SANDBOX_MCP_MAX_PROJECT_BYTES=536870912
# SANDBOX_MCP_MAX_PROJECT_FILES=50000
# SANDBOX_MCP_MAX_ARTIFACT_BYTES=67108864
# SANDBOX_MCP_MAX_ARTIFACTS_PER_EXPERIMENT=200
# SANDBOX_MCP_MAX_DIFF_FILE_BYTES=524288

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Base images an experiment may use. Prefix match on whole path components, so
# "node" accepts node and node/foo but not nodejs-typosquat.
# SANDBOX_MCP_ALLOWED_IMAGE_PREFIXES=["node","python","alpine","debian"]
# SANDBOX_MCP_ALLOW_ANY_IMAGE=false

# Confine project paths to specific roots. Empty means "anywhere except the
# denied roots" (~/.ssh, ~/.aws, /etc, the home directory itself, ...).
# SANDBOX_MCP_ALLOWED_PROJECT_ROOTS=["/Users/you/code"]

# Refuse credential-shaped variable names even when explicitly allowlisted.
# Turning this off lets an agent pull AWS_SECRET_ACCESS_KEY into a container.
# SANDBOX_MCP_STRICT_ENV_DENYLIST=true

# Writable host bind mounts. Leave off: it defeats the point of the product.
# SANDBOX_MCP_ALLOW_WRITABLE_BIND_MOUNTS=false

# Run sandboxes as a non-root user, e.g. "1000:1000". Unset uses the image's
# own default user. Some toolchains expect root inside the container.
# SANDBOX_MCP_SANDBOX_USER=

# Capabilities added back after dropping ALL. The default set is what package
# managers need; it deliberately excludes NET_RAW, MKNOD, SYS_* and SETFCAP.
# SANDBOX_MCP_SANDBOX_CAPABILITIES=["CHOWN","DAC_OVERRIDE","FOWNER","SETUID","SETGID","KILL"]

# ---------------------------------------------------------------------------
# Logging (always to stderr -- stdout carries the MCP protocol)
# ---------------------------------------------------------------------------
# SANDBOX_MCP_LOG_LEVEL=INFO
# SANDBOX_MCP_LOG_JSON=true
